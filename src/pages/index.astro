---
import IconButton from "../components/IconButton.astro";
import Subtitle from "../components/Subtitle.astro";
import Title from "../components/Title.astro";
import Layout from "../layouts/Layout.astro";
import { NAME } from "../data/constants";
---

<Layout title={NAME}>
  <div class="flex h-full w-full flex-col items-center justify-center gap-4">
    <div class="flex flex-col items-center">
      <Title />
      <Subtitle />
    </div>
    <hr class="w-32 border border-slate-500" />
    <div class="flex flex-row gap-8">
      <IconButton
        title="Resume"
        icon="carbon:document-vertical"
        href="/resume"
      />
      <IconButton href="mailto:hi@oisin.ee" target="_blank" title="Email" icon="carbon:email" />
      <IconButton href="https://www.linkedin.com/in/oisincoveney" target="_blank" title="LinkedIn" icon="carbon:logo-linkedin" />
      <IconButton href="https://www.github.com/oisincoveney" target="_blank" title="Github" icon="carbon:logo-github" />
    </div>
  </div>
</Layout>
