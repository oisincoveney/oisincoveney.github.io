---
import { format } from "date-fns";
import { Icon } from "astro-icon/components";
import TechnologyList from "../tech/TechnologyList.astro";
import ResumeItem, { type Props as ResumeItemProps } from "./ResumeItem.astro";

export type Props = {
  companyName?: string;
  fromDate?: Date;
  toDate?: Date;
  location?: string;
  title: string;
  icon?: string;
  class?: string;
  technologies?: string[];
  items?: ResumeItemProps[];
};

const {
  icon,
  companyName,
  fromDate,
  toDate,
  title,
  location,
  technologies = [],
  items = [],
} = Astro.props;
---

<div class="flex flex-col rounded-lg py-4">
  <div class="flex flex-row flex-wrap justify-between">
    <div class="flex flex-row items-center gap-4">
      {
        icon && (
          <span class="grid h-12 w-12 place-items-center rounded-full bg-resume-icon p-1">
            <Icon name={icon} class="text-black" size="2rem" />
          </span>
        )
      }
      <span class="flex flex-col gap-0">
        <span class="text-xl font-bold leading-tight">{companyName}</span>
        <span class="font-regular text-lg italic leading-tight">{title}</span>
      </span>
    </div>
    <div class="flex flex-col gap-0">
      {
        location && (
          <span class="text-md flex flex-row items-center gap-1">
            <Icon name="carbon:location-company" />
            {location}
          </span>
        )
      }
      {
        fromDate && (
          <span class="font-regular text-md flex flex-row items-center gap-1 italic">
            <Icon name="carbon:calendar" />
            {format(fromDate, "MMM y")} to{" "}
            {toDate ? format(toDate, "MMM y") : "Present"}
          </span>
        )
      }
    </div>
  </div>
  {
    technologies && technologies.length > 0 && (
      <div class="col-span-full mb-2 mt-4">
        <TechnologyList technologies={technologies} />
      </div>
    )
  }

  {
    items.map((item) => (
      <div class="col-span-full">
        <ResumeItem
          title={item.title}
          description={item.description}
          link={item.link}
          compact={item.compact}
        />
      </div>
    ))
  }
</div>
